<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>Demo</RootNamespace>
    <AssemblyName>Demo</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Debug-2022;Release-2022;Debug-2023;Release-2023</Configurations>
    <Platforms>AnyCPU</Platforms>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.EndsWith('-2022'))">
    <AutoCadVersion>2022</AutoCadVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('-2023'))">
    <AutoCadVersion>2023</AutoCadVersion>
  </PropertyGroup>

  <PropertyGroup>
    <AutoCadDir>$(ProgramFiles)\Autodesk\AutoCAD $(AutoCadVersion)</AutoCadDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug-2022|AnyCPU'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release-2022|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug-2023|AnyCPU'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release-2023|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <Target Name="ValidateAutoCadInstall" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(AutoCadVersion)' == ''"
           Text="Unknown configuration '$(Configuration)'. Use Debug-2022, Release-2022, Debug-2023, or Release-2023." />
    <Error Condition="!Exists('$(AutoCadDir)\accoremgd.dll')"
           Text="AutoCAD $(AutoCadVersion) not found at $(AutoCadDir)" />
  </Target>

  <ItemGroup>
    <Compile Remove="database\**" />
    <EmbeddedResource Remove="database\**" />
    <None Remove="database\**" />
    <Page Remove="database\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(AutoCadDir)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCadDir)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AutoCadDir)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ui\ContextForm.cs" />
    <Compile Remove="ui\ContextForm.Designer.cs" />
    <Compile Remove="ui\PtMainForm.cs" />
    <Compile Remove="ui\PtMainForm.Designer.cs" />
    <EmbeddedResource Remove="ui\ContextForm.resx" />
    <EmbeddedResource Remove="ui\PtMainForm.resx" />
  </ItemGroup>

  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>
</Project>
