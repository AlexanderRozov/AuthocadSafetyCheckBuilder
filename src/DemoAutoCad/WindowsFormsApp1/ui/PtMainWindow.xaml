<Window x:Class="Demo.ui.PtMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ПТ — объекты и таблицы"
        Height="553" Width="903"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="tabMain" Grid.Row="0" SelectionChanged="TabMain_OnSelectionChanged">
            <TabItem Header="Размещение">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Таблица:" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cmbTable" DisplayMemberPath="Name"
                                      SelectionChanged="CmbTable_OnSelectionChanged"/>
                            <Button Grid.Column="1" Content="Новая таблица..." Margin="8,0,0,0" Padding="8,4"
                                    Click="BtnNewTable_OnClick"/>
                        </Grid>

                        <TextBlock Text="Тип объекта:" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbDeviceType" DisplayMemberPath="Name" Margin="0,0,0,8"
                                  SelectionChanged="CmbDeviceType_OnSelectionChanged"/>

                        <TextBlock Text="Форма:" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbBlock" DisplayMemberPath="Name" Margin="0,0,0,8"
                                  SelectionChanged="CmbBlock_OnSelectionChanged"/>

                        <Border x:Name="borderShapePreview" Margin="0,0,0,8" Padding="8"
                                BorderBrush="#555" BorderThickness="1" CornerRadius="4"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="88" Height="88" Background="#202020" CornerRadius="2">
                                    <Image x:Name="imgPlacementPreview" Stretch="Uniform" Margin="4"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock x:Name="txtPlacementPreviewCode" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="txtPlacementPreviewDescription" Margin="0,6,0,0"
                                               TextWrapping="Wrap" Foreground="#333"/>
                                    <TextBlock x:Name="txtPlacementPreviewBlock" Margin="0,6,0,0"
                                               Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Размер шрифта:"/>
                                <TextBox x:Name="txtFontSize" Text="3.5" Margin="0,4,8,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Номер:"/>
                                <TextBlock x:Name="lblNumberValue" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Подпись:"/>
                        <TextBox x:Name="txtLabel" Margin="0,4,0,8"/>

                        <TextBlock Text="Связать с (род.):" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbParent" DisplayMemberPath="Label" Margin="0,0,0,12"/>

                        <Button Content="Добавить" HorizontalAlignment="Right" Padding="16,6"
                                Click="BtnAdd_OnClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Связи">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Добавить" Padding="10,4" Margin="0,0,6,0" Click="BtnTreeAdd_OnClick"/>
                        <Button Content="Удалить" Padding="10,4" Margin="0,0,6,0" Click="BtnTreeDelete_OnClick"/>
                        <Button Content="▲" Padding="10,4" Margin="0,0,6,0" ToolTip="Переместить вверх"
                                Click="BtnTreeMoveUp_OnClick"/>
                        <Button Content="▼" Padding="10,4" Margin="0,0,6,0" ToolTip="Переместить вниз"
                                Click="BtnTreeMoveDown_OnClick"/>
                        <Button Content="Новый блок" Padding="10,4" Margin="0,0,6,0" Click="BtnNewBlock_OnClick"/>
                        <ComboBox x:Name="cmbBlocks" Width="110" DisplayMemberPath="Name" Margin="0,0,6,0"/>
                        <Button Content="В блок" Padding="10,4" Click="BtnAddToBlock_OnClick"/>
                    </StackPanel>

                    <TreeView x:Name="treeObjects" Grid.Row="1"
                              AllowDrop="True"
                              SelectedItemChanged="TreeObjects_OnSelectedItemChanged"
                              PreviewMouseLeftButtonDown="TreeObjects_OnPreviewMouseLeftButtonDown"
                              PreviewMouseMove="TreeObjects_OnPreviewMouseMove"
                              DragOver="TreeObjects_OnDragOver"
                              Drop="TreeObjects_OnDrop"/>

                    <Grid Grid.Row="2" Margin="0,8,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="В «От»" Padding="8,4" Margin="0,0,6,0" Click="BtnLinkFromSelected_OnClick"/>
                            <Button Content="В «К»" Padding="8,4" Click="BtnLinkToSelected_OnClick"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="От:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="cmbLinkFrom" Grid.Column="1" Margin="0,0,8,0"
                                      DisplayMemberPath="Label" MinWidth="120"/>
                            <TextBlock Grid.Column="2" Text="К:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="cmbLinkTo" Grid.Column="3"
                                      DisplayMemberPath="Label" MinWidth="120"/>
                            <Button Grid.Column="4" Content="Создать связь" Margin="8,0,0,0" Padding="8,4"
                                    Click="BtnCreateLink_OnClick"/>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="3" Text="Связи:" Margin="0,4,0,4"/>
                    <ListBox x:Name="lstLinks" Grid.Row="4"/>
                </Grid>
            </TabItem>

            <TabItem Header="Таблицы">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Таблица:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cmbTableEdit" Width="280" DisplayMemberPath="Name"
                                  SelectionChanged="CmbTableEdit_OnSelectionChanged"/>
                    </StackPanel>
                    <DataGrid x:Name="dgvDevices" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CellEditEnding="DgvDevices_OnCellEditEnding"
                              SelectionMode="Single" IsReadOnly="False"
                              RowHeight="26" FontSize="13" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Подпись" Binding="{Binding Label}" Width="90"/>
                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="50"/>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="55"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="FD" Binding="{Binding FdCode}" Width="65"/>
                            <DataGridTextColumn Header="JS05" Binding="{Binding JsCode}" Width="80"/>
                            <DataGridTextColumn Header="Блок" Binding="{Binding BlockName}" IsReadOnly="True" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Шаблоны объектов">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="Gray"
                               Text="Импорт из таблицы на чертеже (как ПС1/ПС2) или из CSV/Excel. В preview — символ и описание. Колонки CSV: Код;Описание;Блок;Имя;ФайлDWG"/>

                    <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Имя / код:" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtTemplateName" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtTemplateDescription" Margin="0,0,0,8"
                                     ToolTip="Описание (необязательно)"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Из выделения" Padding="10,4" Margin="0,0,6,0"
                                        Click="BtnCreateTemplateFromDrawing_OnClick"/>
                                <Button Content="Из таблицы" Padding="10,4" Margin="0,0,6,0"
                                        Click="BtnImportFromLegendTable_OnClick"/>
                                <Button Content="Из CSV/Excel" Padding="10,4"
                                        Click="BtnImportFromCsv_OnClick"/>
                            </StackPanel>

                            <TextBlock Text="Импорт блока из DWG:" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtImportDwgPath" IsReadOnly="True" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Обзор..." Padding="10,4"
                                        Click="BtnBrowseImportDwg_OnClick"/>
                            </Grid>
                            <ComboBox x:Name="cmbImportBlockName" Margin="0,0,0,4"/>
                            <Button Content="Импортировать блок" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,12"
                                    Click="BtnImportTemplateFromFile_OnClick"/>

                            <TextBlock Text="Шаблоны:" Margin="0,0,0,4"/>
                            <ListBox x:Name="lstPrecreatedTemplates" MinHeight="160"
                                     DisplayMemberPath="DisplayLabel"
                                     SelectionChanged="LstPrecreatedTemplates_OnSelectionChanged"/>
                            <Button Content="Удалить выбранный" HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0"
                                    Click="BtnDeletePrecreatedTemplate_OnClick"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Grid.Column="1" Padding="10" BorderBrush="#555"
                            BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Preview" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Border Width="160" Height="160" Background="#202020" HorizontalAlignment="Center" CornerRadius="2">
                                <Image x:Name="imgTemplatePreview" Stretch="Uniform" Margin="6"/>
                            </Border>
                            <TextBlock x:Name="txtTemplatePreviewCode" FontWeight="Bold" Margin="0,10,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="Описание:" Margin="0,0,0,2" Foreground="Gray"/>
                            <TextBlock x:Name="txtTemplatePreviewDescription" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtTemplatePreviewBlock" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Расставить извещатели">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Таблица:" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbDetectorTable" DisplayMemberPath="Name" Margin="0,0,0,8"
                                  SelectionChanged="CmbDetectorTable_OnSelectionChanged"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Радиус, м:"/>
                                <TextBox x:Name="txtDetectorRadius" Margin="0,4,0,0"
                                         TextChanged="TxtDetectorRadius_OnTextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Шаг сетки, м:"/>
                                <TextBlock x:Name="lblGridStepHint" Margin="0,4,0,0" Foreground="Gray"
                                           Text="≈ 9.04 м (R × √2)"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Направление сетки:" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbGridDirection" Margin="0,0,0,8"/>

                        <TextBlock Text="Штриховка:" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cmbHatchPattern" Grid.Column="0"/>
                            <Button Grid.Column="1" Content="Применить" Margin="8,0,0,0" Padding="8,4"
                                    Click="BtnApplyHatch_OnClick"/>
                        </Grid>

                        <Button x:Name="btnPlaceDetectors" Content="Расставить извещатели"
                                HorizontalAlignment="Left" Padding="16,6" Margin="0,0,0,12"
                                Click="BtnPlaceDetectors_OnClick"/>

                        <TextBlock Text="Зоны:" Margin="0,0,0,4"/>
                        <ListBox x:Name="lstDetectorZones" Height="120" Margin="0,0,0,8"
                                 SelectionChanged="LstDetectorZones_OnSelectionChanged"/>
                        <Button Content="Удалить зону" HorizontalAlignment="Left" Padding="12,4"
                                Click="BtnDeleteZone_OnClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="1" Content="Закрыть" HorizontalAlignment="Right" Margin="0,10,0,0"
                Padding="16,6" Click="BtnClose_OnClick"/>
    </Grid>
</Window>
