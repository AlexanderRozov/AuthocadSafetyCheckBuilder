<Window x:Class="Demo.ui.PtMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ПТ — объекты и таблицы"
        Height="520" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="tabMain" Grid.Row="0" SelectionChanged="TabMain_OnSelectionChanged">
            <TabItem Header="Размещение">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Таблица:" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cmbTable" DisplayMemberPath="Name"
                                      SelectionChanged="CmbTable_OnSelectionChanged"/>
                            <Button Grid.Column="1" Content="Новая таблица..." Margin="8,0,0,0" Padding="8,4"
                                    Click="BtnNewTable_OnClick"/>
                        </Grid>

                        <TextBlock Text="Тип объекта:" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbDeviceType" DisplayMemberPath="Name" Margin="0,0,0,8"
                                  SelectionChanged="CmbDeviceType_OnSelectionChanged"/>

                        <TextBlock Text="Блок:" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbBlock" DisplayMemberPath="Name" Margin="0,0,0,8"
                                  SelectionChanged="CmbDeviceType_OnSelectionChanged"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Размер шрифта:"/>
                                <TextBox x:Name="txtFontSize" Text="3.5" Margin="0,4,8,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Номер:"/>
                                <TextBlock x:Name="lblNumberValue" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Подпись:"/>
                        <TextBlock x:Name="lblPreviewValue" FontWeight="Bold" Margin="0,4,0,8"/>

                        <TextBlock Text="Связать с (род.):" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbParent" DisplayMemberPath="Label" Margin="0,0,0,12"/>

                        <Button Content="Добавить" HorizontalAlignment="Right" Padding="16,6"
                                Click="BtnAdd_OnClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Связи">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Добавить" Padding="10,4" Margin="0,0,6,0" Click="BtnTreeAdd_OnClick"/>
                        <Button Content="Удалить" Padding="10,4" Margin="0,0,6,0" Click="BtnTreeDelete_OnClick"/>
                        <Button Content="Новый блок" Padding="10,4" Margin="0,0,6,0" Click="BtnNewBlock_OnClick"/>
                        <ComboBox x:Name="cmbBlocks" Width="110" DisplayMemberPath="Name" Margin="0,0,6,0"/>
                        <Button Content="В блок" Padding="10,4" Click="BtnAddToBlock_OnClick"/>
                    </StackPanel>

                    <TreeView x:Name="treeObjects" Grid.Row="1" SelectedItemChanged="TreeObjects_OnSelectedItemChanged"/>

                    <Grid Grid.Row="2" Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="От:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cmbLinkFrom" Grid.Column="1" DisplayMemberPath="Label" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="К:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cmbLinkTo" Grid.Column="3" DisplayMemberPath="Label"/>
                        <Button Grid.Column="4" Content="Создать связь" Margin="8,0,0,0" Padding="8,4"
                                Click="BtnCreateLink_OnClick"/>
                    </Grid>

                    <TextBlock Grid.Row="3" Text="Связи:" Margin="0,4,0,4"/>
                    <ListBox x:Name="lstLinks" Grid.Row="4"/>
                </Grid>
            </TabItem>

            <TabItem Header="Таблицы">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Таблица:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cmbTableEdit" Width="280" DisplayMemberPath="Name"
                                  SelectionChanged="CmbTableEdit_OnSelectionChanged"/>
                    </StackPanel>
                    <DataGrid x:Name="dgvDevices" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CellEditEnding="DgvDevices_OnCellEditEnding"
                              SelectionMode="Single" IsReadOnly="False"
                              RowHeight="26" FontSize="13" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Подпись" Binding="{Binding Label}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="50"/>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="55"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="FD" Binding="{Binding FdCode}" Width="65"/>
                            <DataGridTextColumn Header="JS05" Binding="{Binding JsCode}" Width="80"/>
                            <DataGridTextColumn Header="Блок" Binding="{Binding BlockName}" IsReadOnly="True" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="1" Content="Закрыть" HorizontalAlignment="Right" Margin="0,10,0,0"
                Padding="16,6" Click="BtnClose_OnClick"/>
    </Grid>
</Window>
